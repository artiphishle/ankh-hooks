{
  "author": "artiphishle",
  "bugs": {
    "url": "https://github.com/artiphishle/ankh-hooks/issues"
  },
  "description": "Ankhorage collection of hooks",
  "engines": {
    "node": "^22.14.0"
  },
  "homepage": "https://github.com/artiphishle/ankh-hooks#readme",
  "keywords": [
    "ankhorage",
    "ankh",
    "hook",
    "hooks"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "name": "ankh-hooks",
  "paths": {
    "@/*": [
      "./lib/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artiphishle/ankh-hooks.git"
  },
  "dependencies": {
    "uuidv4": "^6.2.13",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/xml2js": "^0.4.14",
    "ankh-types": "^1.1.3",
    "eslint": "^9.10.0",
    "eslint-config-google": "^0.14.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "build": "npm view ankh-hooks version versions dist-tags --json && tsup",
    "changeset:add": "bun changeset",
    "prettier:validate": "bunx prettier --config .prettierrc --write .",
    "prettier:write": "bunx prettier --config .prettierrc --write .",
    "lint": "eslint",
    "lint:fix": "bun run  eslint --fix",
    "prepublish": "bun run build",
    "test": "node --import tsx --test lib/test/index.ts",
    "test:store": "node --import tsx --test lib/test/useIndexedDb.test.ts lib/test/useLocalStorage.test.ts"
  },
  "tsup": {
    "dts": true,
    "entry": {
      "index": "lib/index.ts",
      "store": "lib/hooks/store/index.ts"
    },
    "format": [
      "cjs",
      "esm"
    ],
    "splitting": false,
    "sourcemap": true,
    "minify": true,
    "bundle": true,
    "external": [
      "react"
    ],
    "treeshake": true,
    "clean": true
  },
  "types": "dist/index.d.ts",
  "version": "1.5.2",
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.mjs",
      "require": "./dist/store.js"
    },
    "./*": "./*"
  }
}
